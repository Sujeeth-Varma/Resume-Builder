# Database Configuration
DATABASE_URL=postgresql+asyncpg://resume_user:resume_password@localhost:5432/resume_builder_db
SYNC_DATABASE_URL=postgresql+psycopg2://resume_user:resume_password@localhost:5432/resume_builder_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# NLP & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL_NAME=en_core_web_sm
